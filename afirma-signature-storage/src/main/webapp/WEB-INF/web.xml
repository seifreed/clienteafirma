<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">
  <display-name>SignatureStorageServer</display-name>
  <servlet>
    <description>Servicio de almacenamiento temporal de firmas v1.5</description>
    <servlet-name>StorageService</servlet-name>
    <servlet-class>es.gob.afirma.signfolder.server.proxy.StorageService</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>StorageService</servlet-name>
    <url-pattern>/StorageService</url-pattern>
  </servlet-mapping>
</web-app>