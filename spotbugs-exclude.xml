<!--
	Cliente @firma — filtro de exclusión de SpotBugs.

	M3.6 Oleada 10 (2026-05-20): arranca vacío. Cualquier supresión que sea
	necesaria por falsos positivos del análisis se añade aquí, en este
	registro central — no inline en el código fuente (las pragmas
	@SuppressFBWarnings y similares están prohibidas por CLAUDE.md §
	"No in-line suppressions, no bypasses").

	Cada entrada debe incluir un comentario con: ID de la regla, motivo del
	falso positivo, issue/ticket de seguimiento y fecha límite (default
	365 días desde la introducción).

	Schema: https://spotbugs.readthedocs.io/en/stable/filter.html
-->
<FindBugsFilter
		xmlns="https://github.com/spotbugs/filter/3.0.0"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/master/spotbugs/etc/findbugsfilter.xsd">

	<!-- Sin exclusiones por ahora. -->

</FindBugsFilter>
