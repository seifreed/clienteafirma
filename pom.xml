<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

	<modelVersion>4.0.0</modelVersion>
	<groupId>es.gob.afirma</groupId>
	<artifactId>afirma-client</artifactId>
	<version>1.9.1</version>
	<packaging>pom</packaging>
	
	<name>afirma-client</name>
	<description>Cliente @firma</description>
	<url>https://administracionelectronica.gob.es/ctt/clienteafirma</url>
	
	<developers>
		<developer>
			<name>Agencia Estatal de Administración Digital</name>
			<email>soporte.afirma@correo.gob.es</email>
			<organization>Gobierno de España</organization>
			<organizationUrl>https://administracionelectronica.gob.es</organizationUrl>
		</developer>
	</developers>
	
	<licenses>
		<license>
			<name>GPL-v2.0</name>
			<url>http://www.gnu.org/licenses/gpl-2.0.txt</url>
		</license>
		<license>
			<name>EUPL-v1.1</name>
			<url>http://joinup.ec.europa.eu/system/files/ES/EUPL%20v.1.1%20-%20Licencia.pdf</url>
		</license>
	</licenses>

	<scm>
		<connection>scm:git:https://github.com/ctt-gob-es/clienteafirma.git</connection>
		<developerConnection>scm:git:ssh://github.com/ctt-gob-es/clienteafirma.git</developerConnection>
		<url>https://github.com/ctt-gob-es/clienteafirma</url>
	</scm>

	<properties>
		<project.build.sourceEncoding>utf-8</project.build.sourceEncoding>
		<!-- Java 21 LTS. Migrated from 1.8 on 2026-05-07 (M3.1).
		     <release> semantics enforce that source and bootclasspath both target the
		     declared JDK, so we cannot accidentally use APIs missing from the runtime. -->
		<jdk.version>21</jdk.version>
		<clienteafirma.version>1.9.1</clienteafirma.version>
		<afirma.legible.version>1_9_1</afirma.legible.version>
		<jmulticard.version>2.1</jmulticard.version>
		
		<!-- M3.5 BLOCKED: afirma-lib-itext is a hard fork (com.aowagie.*) with
		     Spanish-specific PAdES patches (PdfPKCS7.getPkcs1(), InvalidPageNumberException,
		     custom createSignature(... char, null, boolean, Calendar) signature,
		     PdfStamper.preClose with Calendar argument, PdfSignature constructor
		     overloads, etc.) that vanilla OpenPDF 1.3.43 / 2.x / 3.x does not have.
		     A drop-in replacement is not possible; M3.5 needs to either upstream
		     the patches to OpenPDF or maintain a forked module. Tracked separately. -->
		<afirma.lib.itext.version>1.7</afirma.lib.itext.version>
		<afirma.lib.others.version>0.0.10</afirma.lib.others.version>
		<!-- BouncyCastle (replaces SpongyCastle 1.58.0.0 from 2018, M3.3 2026-05-07).
		     Provider name changes from "SC" to "BC". The bcutil-jdk18on artifact
		     is required since BC 1.71+ which split utility classes out of bcprov. -->
		<bouncycastle.version>1.85</bouncycastle.version>
		
		<!-- Plugins refreshed 2026-07-15 against Maven Central latest stable. -->
		<maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
		<maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
		<maven-source-plugin.version>3.4.0</maven-source-plugin.version>
		<maven-release-plugin.version>3.3.1</maven-release-plugin.version>
		<maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
		<maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
		<maven-jar-plugin.version>3.5.0</maven-jar-plugin.version>
		<maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
		<central-publishing-maven-plugin.version>0.11.0</central-publishing-maven-plugin.version>

		<!-- supply-chain / CRA tooling -->
		<cyclonedx-maven-plugin.version>2.9.2</cyclonedx-maven-plugin.version>
		<!-- dependency-check 12.x: drop Java 8 baseline, NVD model upgrades.
		     Compatible with our JDK 21 + suppressions schema 1.3. -->
		<dependency-check-maven.version>12.2.2</dependency-check-maven.version>

		<!-- M3.6 quality / hardening tooling (2026-05-07).
		     JaCoCo: line+branch coverage, report-only initially. The `check` goal is
		     intentionally not bound — turning it on as a build gate is deferred until
		     baseline coverage is measured per module (tracked under M3.6 follow-up).
		     PIT: mutation testing, behind `-Pmutation`. JUnit 4 supported by pitest-junit5
		     plugin (also supports JUnit 4 via the vintage engine path, no JUnit 5
		     migration required at this stage).
		     Jazzer: fuzz harness module under `-Pfuzz`, see `afirma-fuzz`. -->
		<!-- M4: Nimbus JOSE+JWT. Backbone of JAdES (compact JWS),
		     SD-JWT VC (issuer-signed JWT + disclosures via com.nimbusds.sd_jwt),
		     and OID4VP (OAuth 2.0 + JWT request objects). Requires Java 11+. -->
		<nimbus-jose-jwt.version>10.9.1</nimbus-jose-jwt.version>

		<jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
		<pitest-maven.version>1.25.7</pitest-maven.version>
		<pitest-junit5-plugin.version>1.2.3</pitest-junit5-plugin.version>
		<jazzer.version>0.24.0</jazzer.version>

		<!-- M3.6 lint gates (Oleada 10, 2026-05-20). Wired in <pluginManagement>
		     and activated only under `-Plint-report` with failOnError/failOnViolation
		     = false. The four tools generate per-module reports under target/site/
		     so a baseline can be measured before any rule is escalated to a build
		     gate (planned for M3.7+). Configuration files live at the repo root:
		     checkstyle-rules.xml, pmd-ruleset.xml, spotbugs-exclude.xml. -->
		<spotless-maven-plugin.version>3.8.0</spotless-maven-plugin.version>
		<maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
		<checkstyle.version>13.8.0</checkstyle.version>
		<maven-pmd-plugin.version>3.28.0</maven-pmd-plugin.version>
		<pmd.version>7.26.0</pmd.version>
		<spotbugs-maven-plugin.version>4.10.3.0</spotbugs-maven-plugin.version>
		<spotbugs.version>4.10.3</spotbugs.version>

		<!-- Reproducible build timestamp (CRA art. 13). Bump on each release. -->
		<project.build.outputTimestamp>2026-07-15T00:00:00Z</project.build.outputTimestamp>

		<!-- test-dependencies. JUnit 5 (Jupiter) is the new default; junit-vintage-engine
		     keeps the existing 146 JUnit 4 Test*.java suites running unchanged on the
		     JUnit Platform. Once a test file imports org.junit.jupiter.api.Test and
		     converts assertions, it runs natively on Jupiter. M3.6 (2026-05-07). -->
		<junit.version>4.13.2</junit.version>
		<junit-jupiter.version>6.1.2</junit-jupiter.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<!-- M3.6: JUnit BOM aligns Jupiter API/Engine + Vintage Engine + Platform.
			     `import` scope means consumers don't need to repeat versions for any
			     org.junit:* artifact below. Surefire 3.5.x auto-detects Platform on
			     classpath and routes JUnit 4 tests through Vintage transparently. -->
			<dependency>
				<groupId>org.junit</groupId>
				<artifactId>junit-bom</artifactId>
				<version>${junit-jupiter.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<dependency>
				<groupId>es.gob.afirma.jmulticard</groupId>
				<artifactId>jmulticard</artifactId>
				<version>${jmulticard.version}</version>
			</dependency>
			
			<dependency>
				<groupId>es.gob.afirma.jmulticard</groupId>
				<artifactId>jmulticard-jse</artifactId>
				<version>${jmulticard.version}</version>
			</dependency>

			<dependency>
				<groupId>es.gob.afirma.jmulticard</groupId>
				<artifactId>jmulticard-jsr268</artifactId>
				<version>${jmulticard.version}</version>
			</dependency>
			
			<dependency>
				<groupId>es.gob.afirma.lib</groupId>
				<artifactId>afirma-lib-itext</artifactId>
				<version>${afirma.lib.itext.version}</version>
			</dependency>

			<dependency>
				<groupId>es.gob.afirma.lib</groupId>
				<artifactId>afirma-lib-jmimemagic</artifactId>
				<version>${afirma.lib.others.version}</version>
			</dependency>
			
			<dependency>
				<groupId>es.gob.afirma.lib</groupId>
				<artifactId>afirma-lib-oro</artifactId>
				<version>${afirma.lib.others.version}</version>
			</dependency>

			<dependency>
				<groupId>es.gob.afirma.lib</groupId>
				<artifactId>afirma-lib-juniversalchardet</artifactId>
				<version>${afirma.lib.others.version}</version>
			</dependency>

			<!-- BouncyCastle 1.84+ replaces SpongyCastle 1.58 (M3.3, 2026-05-07).
			     Provider registers as "BC" not "SC". -->
			<dependency>
				<groupId>org.bouncycastle</groupId>
				<artifactId>bcprov-jdk18on</artifactId>
				<version>${bouncycastle.version}</version>
			</dependency>

			<dependency>
				<groupId>org.bouncycastle</groupId>
				<artifactId>bcpkix-jdk18on</artifactId>
				<version>${bouncycastle.version}</version>
			</dependency>

			<dependency>
				<groupId>org.bouncycastle</groupId>
				<artifactId>bcutil-jdk18on</artifactId>
				<version>${bouncycastle.version}</version>
			</dependency>
			
			<dependency>
				<groupId>es.uji.crypto.xades</groupId>
				<artifactId>jxades</artifactId>
				<version>0.2.2</version>
			</dependency>
			
			<dependency>
				<groupId>org.apache.santuario</groupId>
				<artifactId>xmlsec</artifactId>
				<version>4.0.4</version>
			</dependency>

			<dependency>
				<groupId>junit</groupId>
				<artifactId>junit</artifactId>
				<version>${junit.version}</version>
				<scope>test</scope>
			</dependency>

			<!-- Jakarta Servlet 6.x — Jakarta EE 10 namespace (jakarta.servlet.*).
			     Targets Tomcat 10.1+ / Jetty 12+. Migrated from javax.servlet 2.5
			     in M3.2 (2026-05-07). The 3 WAR modules (server-triphase-signer,
			     signature-retriever, signature-storage) consume this. -->
			<dependency>
				<groupId>jakarta.servlet</groupId>
				<artifactId>jakarta.servlet-api</artifactId>
				<version>6.1.0</version>
				<scope>provided</scope>
			</dependency>

			<!-- M4: Nimbus JOSE+JWT — JWS / JWE / SD-JWT primitives. Used by:
			     afirma-crypto-jades (JAdES-B-B compact JWS),
			     afirma-eudiw-bridge (OID4VP request objects + SD-JWT VC parsing). -->
			<dependency>
				<groupId>com.nimbusds</groupId>
				<artifactId>nimbus-jose-jwt</artifactId>
				<version>${nimbus-jose-jwt.version}</version>
			</dependency>

			<!-- Force patched Rhino. proxy-vole 1.0.18 brings rhino-runtime 1.7.13
			     transitively via delight-rhino-sandbox 0.0.15 (PAC/JS evaluation backend).
			     The current code in ProxyUtil only registers Strategy.OS_DEFAULT and
			     Strategy.BROWSER, never Strategy.JAVA, so Rhino sits unused in the
			     classpath at runtime. The override patches CVE-2025-66453 defensively
			     for the case anyone adds Strategy.JAVA in the future — see the
			     companion regression test TestProxyUtilStrategies in afirma-simple
			     which fails the build if a new strategy is added without re-evaluating
			     this override. Remove this entry when proxy-vole upgrades past 1.0.18
			     and brings rhino-runtime >= 1.7.15.1 transitively. -->
			<dependency>
				<groupId>org.mozilla</groupId>
				<artifactId>rhino-runtime</artifactId>
				<version>1.7.15.1</version>
			</dependency>

		</dependencies>
	</dependencyManagement>

	<!-- M3.6: every module gets JUnit Platform + Jupiter + Vintage Engine on its
	     test classpath. junit-vintage-engine transitively brings junit:junit:4.13.2
	     so the existing 146 JUnit 4 Test*.java files keep working without code
	     changes. New tests should import org.junit.jupiter.api.* directly. -->
	<dependencies>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.vintage</groupId>
			<artifactId>junit-vintage-engine</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>${maven-compiler-plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-enforcer-plugin</artifactId>
					<version>${maven-enforcer-plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-jar-plugin</artifactId>
					<version>${maven-jar-plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>${maven-surefire-plugin.version}</version>
				</plugin>
				<!-- CycloneDX SBOM (CRA art. 13). Activated under env-install / env-deploy. -->
				<plugin>
					<groupId>org.cyclonedx</groupId>
					<artifactId>cyclonedx-maven-plugin</artifactId>
					<version>${cyclonedx-maven-plugin.version}</version>
					<configuration>
						<projectType>library</projectType>
						<schemaVersion>1.5</schemaVersion>
						<includeBomSerialNumber>true</includeBomSerialNumber>
						<includeCompileScope>true</includeCompileScope>
						<includeProvidedScope>true</includeProvidedScope>
						<includeRuntimeScope>true</includeRuntimeScope>
						<includeSystemScope>true</includeSystemScope>
						<includeTestScope>false</includeTestScope>
						<includeLicenseText>false</includeLicenseText>
						<outputFormat>all</outputFormat>
						<outputName>bom</outputName>
					</configuration>
				</plugin>
				<!-- OWASP dependency-check. Report-only initially; failBuildOnCVSS lifted in M2.
				     Requires an NVD API key for usable update times. Get a free key at
				     https://nvd.nist.gov/developers/request-an-api-key and pass it as
				     `-DnvdApiKey=<key>` or set <nvdApiKey> in ~/.m2/settings.xml. -->
				<plugin>
					<groupId>org.owasp</groupId>
					<artifactId>dependency-check-maven</artifactId>
					<version>${dependency-check-maven.version}</version>
					<configuration>
						<failOnError>false</failOnError>
						<failBuildOnCVSS>11</failBuildOnCVSS>
						<formats>
							<format>HTML</format>
							<format>JSON</format>
							<format>SARIF</format>
						</formats>
						<suppressionFiles>
							<suppressionFile>${maven.multiModuleProjectDirectory}/.dependency-check-suppressions.xml</suppressionFile>
						</suppressionFiles>
						<skipProvidedScope>false</skipProvidedScope>
						<skipRuntimeScope>false</skipRuntimeScope>
						<skipTestScope>true</skipTestScope>
						<knownExploitedEnabled>false</knownExploitedEnabled>
						<!-- 1-week NVD cache; CI runs daily incremental updates. -->
						<nvdValidForHours>168</nvdValidForHours>
					</configuration>
				</plugin>

				<!-- M3.6: JaCoCo line+branch coverage. Bound to test phase via the
				     top-level <plugins> below so every module produces a per-module
				     report under target/site/jacoco/. The `check` goal is intentionally
				     not bound (no enforced minimum yet); flip to a gate once the
				     baseline per module is measured. -->
				<plugin>
					<groupId>org.jacoco</groupId>
					<artifactId>jacoco-maven-plugin</artifactId>
					<version>${jacoco-maven-plugin.version}</version>
				</plugin>

				<!-- M3.6: PIT mutation testing. Active only under `-Pmutation`.
				     With JUnit Platform on the test classpath (Jupiter + Vintage)
				     pitest-junit5-plugin can route to either engine. JUnit 4 tests
				     keep running through the Vintage engine path. -->
				<plugin>
					<groupId>org.pitest</groupId>
					<artifactId>pitest-maven</artifactId>
					<version>${pitest-maven.version}</version>
					<dependencies>
						<dependency>
							<groupId>org.pitest</groupId>
							<artifactId>pitest-junit5-plugin</artifactId>
							<version>${pitest-junit5-plugin.version}</version>
						</dependency>
					</dependencies>
				</plugin>

				<!-- M3.6 Oleada 10 (2026-05-20): lint baseline. The four plugins below
				     are declared in <pluginManagement> with their soft-baseline configs
				     and only get *executed* under the `lint-report` profile, where they
				     run with failOnError/failOnViolation = false. The default build is
				     unaffected. Configuration files at the repo root. -->
				<plugin>
					<groupId>com.diffplug.spotless</groupId>
					<artifactId>spotless-maven-plugin</artifactId>
					<version>${spotless-maven-plugin.version}</version>
					<configuration>
						<java>
							<includes>
								<include>src/main/java/**/*.java</include>
								<include>src/test/java/**/*.java</include>
							</includes>
							<!-- Tabs (4-wide) match the repo style. removeUnusedImports
							     is non-destructive given the existing import discipline. -->
							<removeUnusedImports/>
							<trimTrailingWhitespace/>
							<endWithNewline/>
							<importOrder>
								<order>java,javax,jakarta,org,com,es</order>
							</importOrder>
						</java>
					</configuration>
				</plugin>

				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-checkstyle-plugin</artifactId>
					<version>${maven-checkstyle-plugin.version}</version>
					<dependencies>
						<dependency>
							<groupId>com.puppycrawl.tools</groupId>
							<artifactId>checkstyle</artifactId>
							<version>${checkstyle.version}</version>
						</dependency>
					</dependencies>
					<configuration>
						<configLocation>${maven.multiModuleProjectDirectory}/checkstyle-rules.xml</configLocation>
						<consoleOutput>true</consoleOutput>
						<failOnViolation>false</failOnViolation>
						<failsOnError>false</failsOnError>
						<includeTestSourceDirectory>false</includeTestSourceDirectory>
						<linkXRef>false</linkXRef>
					</configuration>
				</plugin>

				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-pmd-plugin</artifactId>
					<version>${maven-pmd-plugin.version}</version>
					<dependencies>
						<dependency>
							<groupId>net.sourceforge.pmd</groupId>
							<artifactId>pmd-core</artifactId>
							<version>${pmd.version}</version>
						</dependency>
						<dependency>
							<groupId>net.sourceforge.pmd</groupId>
							<artifactId>pmd-java</artifactId>
							<version>${pmd.version}</version>
						</dependency>
					</dependencies>
					<configuration>
						<rulesets>
							<ruleset>${maven.multiModuleProjectDirectory}/pmd-ruleset.xml</ruleset>
						</rulesets>
						<failOnViolation>false</failOnViolation>
						<printFailingErrors>true</printFailingErrors>
						<includeTests>false</includeTests>
						<linkXRef>false</linkXRef>
						<targetJdk>${jdk.version}</targetJdk>
						<!-- threads=1 forces single-threaded execution. PMD 7.x worker
						     threads do not inherit MAVEN_OPTS -Xss, so deep generics in
						     this codebase trigger StackOverflowError on the worker
						     threads but not on the main thread. -->
						<threads>1</threads>
						<!-- skipPmdError keeps the build green when PMD encounters
						     analysis errors (StackOverflow, type-resolution glitches
						     in PMD 7.x on legacy code). Errors still appear in target/
						     pmd.xml for diagnosis; the rest of the lint pipeline keeps
						     running. -->
						<skipPmdError>true</skipPmdError>
					</configuration>
				</plugin>

				<plugin>
					<groupId>com.github.spotbugs</groupId>
					<artifactId>spotbugs-maven-plugin</artifactId>
					<version>${spotbugs-maven-plugin.version}</version>
					<dependencies>
						<dependency>
							<groupId>com.github.spotbugs</groupId>
							<artifactId>spotbugs</artifactId>
							<version>${spotbugs.version}</version>
						</dependency>
					</dependencies>
					<configuration>
						<effort>Default</effort>
						<threshold>Medium</threshold>
						<failOnError>false</failOnError>
						<includeTests>false</includeTests>
						<excludeFilterFile>${maven.multiModuleProjectDirectory}/spotbugs-exclude.xml</excludeFilterFile>
						<xmlOutput>true</xmlOutput>
						<htmlOutput>true</htmlOutput>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>

		<!-- JaCoCo runs on every build (default + every profile) so coverage data
		     accumulates without requiring a special profile. -->
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<executions>
					<execution>
						<id>require-supported-maven</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<requireMavenVersion>
									<version>[3.6.3,)</version>
								</requireMavenVersion>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>jacoco-prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>jacoco-report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
	
	<profiles>
		<!-- ===== M3.6: mutation testing on demand =====
		     Activate with `-Pmutation`. Recommended scope: one module at a time,
		     e.g. `mvn -Pmutation -pl afirma-crypto-cades test`. Reports land at
		     <module>/target/pit-reports/index.html. failWhenNoMutations=false so
		     modules without tests don't break aggregate runs. -->
		<profile>
			<id>mutation</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.pitest</groupId>
						<artifactId>pitest-maven</artifactId>
						<configuration>
							<timestampedReports>false</timestampedReports>
							<failWhenNoMutations>false</failWhenNoMutations>
							<outputFormats>
								<outputFormat>HTML</outputFormat>
								<outputFormat>XML</outputFormat>
							</outputFormats>
							<!-- JDK 21+: same add-opens that the runtime fat JARs need
							     for the keystore providers. PIT forks a minion JVM. -->
							<jvmArgs>
								<value>--add-opens=java.base/sun.security.x509=ALL-UNNAMED</value>
								<value>--add-opens=java.base/sun.security.util=ALL-UNNAMED</value>
								<value>--add-opens=java.base/sun.security.pkcs11=ALL-UNNAMED</value>
								<value>--add-opens=java.base/sun.security.mscapi=ALL-UNNAMED</value>
								<value>--enable-native-access=ALL-UNNAMED</value>
							</jvmArgs>
							<targetClasses>
								<param>es.gob.afirma.*</param>
							</targetClasses>
							<targetTests>
